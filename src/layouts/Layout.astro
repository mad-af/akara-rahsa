---
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/noto-sans';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, url } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Pages that own their full-bleed top edge (the landing hero) opt out of padding. */
  bleed?: boolean;
}

const {
  title = `${site.name}, ${site.tagline}`,
  description = site.description,
  bleed = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://akarahsa.com');
const ogImage = new URL(url('og.jpg'), Astro.site ?? 'https://akarahsa.com');
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta name="theme-color" content="#0b0b0c" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- TODO: add public/og.jpg, 1200x630, dark with the wordmark in gold. -->
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Placeholder photography is served from Pexels until real work lands. -->
    <link rel="preconnect" href="https://images.pexels.com" crossorigin />

    <script is:inline>
      // Marks the document as JS-capable before first paint, so elements GSAP
      // will reveal can start hidden without risking a permanently blank page
      // if the bundle fails to load.
      document.documentElement.classList.add('js-motion');
    </script>
  </head>

  <body>
    <a href="#main" class="skip">Lewati ke konten</a>
    <Header />
    <main id="main" class={bleed ? '' : 'pad'}>
      <slot />
    </main>
    <Footer />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background-color: var(--color-gold);
        color: var(--color-ground);
        font-size: 0.8125rem;
        font-weight: 600;
      }
      .skip:focus {
        left: 1rem;
        top: 1rem;
      }
      .pad {
        padding-top: 4rem;
      }
    </style>
  </body>
</html>
