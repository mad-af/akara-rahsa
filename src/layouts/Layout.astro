---
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/noto-sans';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { site, url } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Pages that own their full-bleed top edge (the landing hero) opt out of padding. */
  bleed?: boolean;
}

const {
  title = `${site.name}, ${site.tagline}`,
  description = site.description,
  bleed = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://akarahsa.com');
const ogImage = new URL(url('og-default.jpg'), Astro.site ?? 'https://akarahsa.com');
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <!-- sizes="any" keeps older browsers, which cannot read the SVG, from
         treating it as a same-priority alternative and picking neither. -->
    <link rel="icon" href={url('favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('site.webmanifest')} />
    <meta name="theme-color" content="#0b0b0c" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <!-- Width and height let a scraper lay the card out before the image has
         finished downloading; without them some defer rendering it entirely. -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.tagline}`} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- Placeholder photography is served from Pexels until real work lands. -->
    <link rel="preconnect" href="https://images.pexels.com" crossorigin />

    <script is:inline>
      // Marks the document as JS-capable before first paint, so elements GSAP
      // will reveal can start hidden without risking a permanently blank page
      // if the bundle fails to load.
      document.documentElement.classList.add('js-motion');
    </script>
  </head>

  <body>
    <a href="#main" class="skip">Lewati ke konten</a>
    <Header />
    <main id="main" class={bleed ? '' : 'pad'}>
      <slot />
    </main>
    <Footer />
    <WhatsAppFab />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background-color: var(--color-gold);
        color: var(--color-ground);
        font-size: 0.8125rem;
        font-weight: 600;
      }
      .skip:focus {
        left: 1rem;
        top: 1rem;
      }
      /* The bar is fixed, so it reserves no space of its own. Pages that are
         not full-bleed have to account for it plus their own breathing room. */
      .pad {
        padding-top: calc(var(--nav-h) + 4rem);
      }
    </style>
  </body>
</html>
